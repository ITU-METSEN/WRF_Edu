&share
 wrf_core = 'ARW',
 max_dom = 1,
 start_date = '2026-01-17_00:00:00',
 end_date   = '2026-01-18_00:00:00',
 interval_seconds = 3600
/

&geogrid
 parent_id         = 1,
 parent_grid_ratio = 1,
 i_parent_start    = 1,
 j_parent_start    = 1,
 e_we              = 900,
 e_sn              = 800,
 geog_data_res     = 'default',
 dx                = 3000,
 dy                = 3000,
 map_proj          = 'lambert',
 ref_lat           = 37.5,
 ref_lon           = 34.0,
 truelat1          = 30.0,
 truelat2          = 60.0,
 stand_lon         = 34.0,
 geog_data_path    = '/home/wrfuser/WPS_GEOG',
/

&ungrib
 out_format = 'WPS',
 prefix = 'ERA5_PL',
/

&metgrid
 fg_name = 'ERA5_SFC','ERA5_SST','ERA5_PL',
/
